import random
import colorama

# Навіяно фільмом "Траса 60"

yellow = "\033[38;2;255;255;0m"
dark_blue = "\033[48;2;0;0;128m"

answers: list[str] = [
    "Безперечно",
    "Це вирішено",
    "Без сумніву",
    "Однозначно так",
    "Можеш на це розраховувати",
    "Як на мене, так",
    "Найімовірніше",
    "Перспективи добрі",
    "Так",
    "Знаки вказують, що так",
    "Відповідь туманна, спробуй ще",
    "Спитай пізніше",
    "Краще зараз не казати",
    "Зараз не можу передбачити",
    "Зосередься і спитай знову",
    "Не розраховуй на це",
    "Моя відповідь - ні",
    "Мої джерела кажуть, що ні",
    "Перспективи не дуже",
    "Дуже сумнівно",
    "Погана ідея",
    "Можеш уточнити?",
    "Це тобі вирішувати",
]


def ask_ball() -> str:
    return random.choice(answers)


print("Шукаєш поради? Дозволь кулі передбачень визначити твою долю. Постав питання або натисни Enter, щоб вийти")

counts: dict[str, int] = {}

while True:
    question = input("Твоє питання: ").strip()

    if question == "":
        break

    if not question.endswith("?"):
        print("Питання має закінчуватися знаком питання")
        continue

    answer = ask_ball()
    print(yellow + dark_blue + "🎱🔽 Куля каже: " + answer + " " + colorama.Style.RESET_ALL)

    if answer not in counts:
        counts[answer] = 0
    counts[answer] += 1

print("Куля каже:")
for answer, count in counts.items():
    print(f"{answer}: {count}")
